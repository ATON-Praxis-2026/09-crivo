# === Autopilot de Eventos — configuração ===

# Chave da Anthropic (Claude). SEM esta chave o app roda em MODO DEMO
# (dados simulados percorrendo a mesma pipeline). Com a chave, a pipeline
# real (busca web nativa do Claude + BrasilAPI) é ativada automaticamente.
ANTHROPIC_API_KEY=

# DEIXE EM BRANCO. Chave de API (sk-ant-...) já nasce vinculada ao workspace —
# nenhum header extra é necessário (não existe "chave identity-linked" com
# header por requisição na API da Anthropic). Esta variável só teria uso em
# federação de identidade corporativa (WIF); preenchida aqui, enviaria um
# header não reconhecido em toda chamada.
ANTHROPIC_WORKSPACE_ID=

# Armazenamento: "sqlite" (padrão local) ou "memory" (usado no deploy demo/Vercel)
DATA_STORE=sqlite

# Cidade padrão sugerida nos formulários (configurável)
NEXT_PUBLIC_DEFAULT_CITY=Curitiba

# Overrides opcionais de modelo
MODEL_DESCOBRIDOR=claude-haiku-4-5
MODEL_VERIFICADOR=claude-sonnet-5
MODEL_REFINADOR=claude-sonnet-5
MODEL_JUSTIFICATIVAS=claude-sonnet-5

# Força o modo demo mesmo com chave presente (útil para ensaiar o pitch)
# MOCK_MODE=true
